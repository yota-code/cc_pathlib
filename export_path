#!/usr/bin/env zsh

if [[ "$OSTYPE" == "msys" || "$OSTYPE" == "cygwin" ]]; then
	SEP=';'
else
	SEP=':'
fi

source_DIR=$0:A:h

function push_pythonpath() {
	echo "    pythonpath += $1"
	pth=$(realpath $1)
	export PATH=${pth}/script${PATH:+:$PATH}
	export PYTHONPATH=${pth}/package${PYTHONPATH:+${SEP}$PYTHONPATH}
}

push_pythonpath ${source_DIR}

typeset -T PYTHONPATH pythonpath

typeset -U pythonpath
typeset -U path

